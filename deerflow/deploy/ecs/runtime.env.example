AUTH_JWT_SECRET=GENERATE_UNIQUE_RANDOM_SECRET
BETTER_AUTH_SECRET=GENERATE_UNIQUE_RANDOM_SECRET
DEER_FLOW_INTERNAL_AUTH_TOKEN=GENERATE_UNIQUE_RANDOM_SECRET
DEER_FLOW_HOME=/var/lib/deerflow
DEER_FLOW_PROJECT_ROOT=/opt/deerflow
DEER_FLOW_CONFIG_PATH=/opt/deerflow/config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=/opt/deerflow/extensions_config.json
DEER_FLOW_SKILLS_PATH=/opt/deerflow/skills
DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai
DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://127.0.0.1:8001
DEER_FLOW_TRUSTED_ORIGINS=http://localhost:2028,http://127.0.0.1:2028,https://deerflow.shihongyuan.cn
DEER_FLOW_SANDBOX_MEMORY=768m
DEER_FLOW_SANDBOX_CPUS=1.5
DEER_FLOW_SANDBOX_BIND_HOST=127.0.0.1
GATEWAY_ENABLE_DOCS=false
LANGSMITH_TRACING=false
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=256
HOSTNAME=127.0.0.1
PORT=3000
PYTHONUNBUFFERED=1
PYTHONPATH=/opt/deerflow/backend

DEER_FLOW_DEMO_LOGIN_ENABLED=false
DEER_FLOW_DEMO_USER_ID=
